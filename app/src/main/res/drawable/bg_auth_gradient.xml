<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle top-glow over the window background for auth/splash depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_deepest" />
        </shape>
    </item>
    <item android:gravity="top" android:height="360dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/accent_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>

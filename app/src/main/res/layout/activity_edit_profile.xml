<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="@dimen/space_28"
        android:paddingBottom="@dimen/space_12">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="@dimen/stroke_hairline">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                android:scaleType="centerInside"
                app:tint="?attr/colorOnSurface" />
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Edit Profile"
            android:textAppearance="@style/TextAppearance.Aegis.H2" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_48">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_24"
            android:focusableInTouchMode="true"
            android:layoutAnimation="@anim/layout_animation_stagger">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_24">

                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnChangeAvatar"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        app:cardBackgroundColor="@color/accent_soft"
                        app:cardCornerRadius="60dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/aegis_blue"
                        app:strokeWidth="2dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:id="@+id/ivAvatarEdit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_person"
                            app:tint="@color/accent_primary" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="bottom|end"
                        app:cardBackgroundColor="@color/aegis_blue"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_camera" app:tint="@color/colorOnPrimary"/>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to change photo"
                    android:textAppearance="@style/TextAppearance.Aegis.Caption"
                    android:layout_marginTop="@dimen/space_10"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:text="DRIVER NAME"
                android:textAppearance="@style/TextAppearance.Aegis.Label" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_elevated_rounded"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:hint="Enter your name"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:singleLine="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:text="EMAIL ADDRESS"
                android:textAppearance="@style/TextAppearance.Aegis.Label" />

            <EditText
                android:id="@+id/etEmailRead"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_elevated_rounded"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center_vertical"
                android:enabled="false"
                android:focusable="false"
                android:text="driver@aegisdrive.com"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                style="@style/Aegis.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_32"
                android:text="Save Changes" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:background="@color/border_subtle"
                android:layout_marginTop="@dimen/space_28"
                android:layout_marginBottom="@dimen/space_20"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANGER ZONE"
                android:textColor="@color/status_danger"
                android:textAppearance="@style/TextAppearance.Aegis.Label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteAccount"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_12"
                android:text="Delete Account"
                android:textAllCaps="false"
                android:textColor="@color/status_danger"
                android:fontFamily="@font/inter_semibold"
                app:strokeColor="@color/status_danger"
                app:strokeWidth="@dimen/stroke_hairline"
                app:cornerRadius="@dimen/radius_md"
                app:rippleColor="@color/status_danger_soft" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_2xl"
    app:cardElevation="@dimen/elevation_float"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:trackThickness="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="◉"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Authenticating"
            android:textAppearance="@style/TextAppearance.Aegis.Title"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aegis Secure Network"
            android:textAppearance="@style/TextAppearance.Aegis.Caption"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

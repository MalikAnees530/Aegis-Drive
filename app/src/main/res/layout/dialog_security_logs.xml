<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_24">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/accent_soft"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/accent_primary" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_16"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Security Logs"
                android:textAppearance="@style/TextAppearance.Aegis.H2" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System integrity status"
                android:textAppearance="@style/TextAppearance.Aegis.Caption" />
        </LinearLayout>
    </LinearLayout>

    <!-- Log Items Group -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="@dimen/stroke_hairline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- AI Engine -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_cpu" app:tint="@color/accent_primary" android:layout_marginEnd="@dimen/space_16" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Core AI Engine" android:textAppearance="@style/TextAppearance.Aegis.Body" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Neural monitoring active &amp; ready" android:textAppearance="@style/TextAppearance.Aegis.Caption" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ONLINE" android:textColor="@color/status_safe" android:textAppearance="@style/TextAppearance.Aegis.Label" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="@dimen/stroke_hairline" android:background="@color/border_subtle" android:layout_marginVertical="@dimen/space_16" />

            <!-- Cloud Sync -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_cloud" app:tint="@color/accent_primary" android:layout_marginEnd="@dimen/space_16" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Secure Cloud Bridge" android:textAppearance="@style/TextAppearance.Aegis.Body" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Encrypted telemetry sync" android:textAppearance="@style/TextAppearance.Aegis.Caption" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SYNCED" android:textColor="@color/status_safe" android:textAppearance="@style/TextAppearance.Aegis.Label" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="@dimen/stroke_hairline" android:background="@color/border_subtle" android:layout_marginVertical="@dimen/space_16" />

            <!-- Navigation Intel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_location_pin" app:tint="@color/accent_primary" android:layout_marginEnd="@dimen/space_16" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Navigation Intel" android:textAppearance="@style/TextAppearance.Aegis.Body" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Precision tracking &amp; routing live" android:textAppearance="@style/TextAppearance.Aegis.Caption" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVE" android:textColor="@color/aegis_blue" android:textAppearance="@style/TextAppearance.Aegis.Label" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        style="@style/Aegis.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_24"
        android:text="Acknowledge" />

</LinearLayout>

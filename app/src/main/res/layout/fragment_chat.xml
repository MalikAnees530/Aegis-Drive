<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <!-- HEADER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chatHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_16"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="@dimen/stroke_hairline"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_12">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnMenu"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardBackgroundColor="@color/bg_elevated"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="@dimen/stroke_hairline">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/text_primary"/>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/chatHeaderCenter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_marginEnd="@dimen/space_8"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_cpu"
                        app:tint="@color/accent_primary"
                        android:layout_marginEnd="@dimen/space_10"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aegis Intelligence"
                            android:textAppearance="@style/TextAppearance.Aegis.Title"
                            android:ellipsize="end"
                            android:maxLines="1"/>
                        <TextView
                            android:id="@+id/tvSafetyMirror"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI SAFE • 100%"
                            android:textColor="@color/status_safe"
                            android:textAppearance="@style/TextAppearance.Aegis.Label"/>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNewChat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="@color/aegis_blue"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="+"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="24sp"
                        android:fontFamily="@font/inter_regular"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MESSAGES -->
        <ScrollView
            android:id="@+id/chatScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/space_16"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:paddingBottom="@dimen/space_48"
            app:layout_constraintTop_toBottomOf="@id/chatHeader"
            app:layout_constraintBottom_toTopOf="@id/audioControlPanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/chatMessagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"/>
        </ScrollView>

        <!-- AUDIO ORBS -->
        <LinearLayout
            android:id="@+id/audioControlPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_8"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/quickChipsRow"
            app:layout_constraintEnd_toEndOf="@id/chatInputBar">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnDeactivateMic"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="@dimen/space_12"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="27dp"
                app:cardElevation="@dimen/elevation_float"
                app:strokeColor="@color/status_danger"
                app:strokeWidth="2dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic_off_modern"
                    app:tint="@color/status_danger"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPlaySpeak"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="@dimen/space_12"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="27dp"
                app:cardElevation="@dimen/elevation_float"
                app:strokeColor="@color/aegis_blue"
                app:strokeWidth="2dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_speaker_ai"
                    app:tint="@color/aegis_blue"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStopSpeak"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="27dp"
                app:cardElevation="@dimen/elevation_float"
                app:strokeColor="@color/status_danger"
                app:strokeWidth="2dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_stop_modern"
                    app:tint="@color/status_danger"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- QUICK CHIPS -->
        <HorizontalScrollView
            android:id="@+id/quickChipsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/chatInputBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipSafety"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_10"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/radius_pill"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="@dimen/stroke_hairline">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_10">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_shield_check" app:tint="@color/status_safe" android:layout_marginEnd="@dimen/space_8"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Safety Score" android:textColor="?attr/colorOnSurface" android:fontFamily="@font/inter_medium" android:textSize="13sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/radius_pill"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="@dimen/stroke_hairline">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_10">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_home" app:tint="@color/accent_primary" android:layout_marginEnd="@dimen/space_8"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Navigate Home" android:textColor="?attr/colorOnSurface" android:fontFamily="@font/inter_medium" android:textSize="13sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- INPUT BAR -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chatInputBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_16"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="30dp"
            app:cardElevation="@dimen/elevation_soft"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="@dimen/stroke_hairline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_8">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnMic"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_8"
                    app:cardBackgroundColor="@color/bg_elevated"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/ivMicIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic_modern"
                        app:tint="@color/aegis_blue"/>
                </com.google.android.material.card.MaterialCardView>

                <EditText
                    android:id="@+id/etChatInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Message Aegis AI..."
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_regular"
                    android:background="@null"
                    android:inputType="text"
                    android:imeOptions="actionSend"
                    android:maxLines="4"
                    android:paddingHorizontal="@dimen/space_10"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSend"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/space_8"
                    app:cardBackgroundColor="@color/aegis_blue"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_send_modern"
                        app:tint="@color/colorOnPrimary"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SIDE DRAWER: SESSIONS -->
    <com.google.android.material.navigation.NavigationView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/space_24"
            android:background="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_24">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_12"
                    app:cardBackgroundColor="@color/accent_soft"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chart"
                        app:tint="@color/accent_primary"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Sessions"
                    android:textAppearance="@style/TextAppearance.Aegis.H2"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="@dimen/stroke_hairline">
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/space_48">
                    <LinearLayout
                        android:id="@+id/sessionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12"/>
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDeleteAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                app:cardBackgroundColor="@color/status_danger_soft"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteAllSessions"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Wipe Intelligence History"
                    android:textColor="@color/status_danger"
                    android:fontFamily="@font/inter_semibold"
                    android:textAllCaps="false" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>

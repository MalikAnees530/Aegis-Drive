<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_24"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_4">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:text="If more than 10 safety alerts are triggered in a single drive, Aegis Drive will automatically text this contact — no action needed from the driver. Standard carrier SMS rates apply."
        android:textAppearance="@style/TextAppearance.Aegis.BodyMuted" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEmergencyNumber"
        style="@style/AegisDrive.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone number (e.g. +44 7123 456789)"
        app:startIconDrawable="@drawable/ic_phone"
        app:startIconTint="@color/aegis_blue"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmergencyNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>

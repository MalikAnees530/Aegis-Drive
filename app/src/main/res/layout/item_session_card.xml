<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_6"
    android:layout_marginHorizontal="@dimen/space_2"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="@dimen/stroke_hairline"
    app:rippleColor="@color/accent_glow"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/icon_chip"
            android:layout_height="@dimen/icon_chip"
            app:cardBackgroundColor="@color/accent_soft"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            android:layout_marginEnd="@dimen/space_16">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_chart" app:tint="@color/accent_primary"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvSessionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session --"
                android:textAppearance="@style/TextAppearance.Aegis.Title" />
            <TextView
                android:id="@+id/tvSessionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date --"
                android:textAppearance="@style/TextAppearance.Aegis.Caption"
                android:layout_marginTop="@dimen/space_2" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSessionScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="@color/accent_primary"
            android:fontFamily="@font/space_grotesk_bold"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_4"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

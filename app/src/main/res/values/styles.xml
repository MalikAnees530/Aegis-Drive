<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================================================ -->
    <!-- AEGISDRIVE — COMPONENT + TYPOGRAPHY STYLES                    -->
    <!-- Token-driven; theme-attr + DayNight colors adapt to modes.   -->
    <!-- ============================================================ -->

    <!-- ══════════ TYPOGRAPHY ══════════ -->
    <!-- Headings: Space Grotesk · Body/labels: Inter -->

    <style name="TextAppearance.Aegis.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <style name="TextAppearance.Aegis.H1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.Aegis.H2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Aegis.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Aegis.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.Aegis.BodyMuted" parent="TextAppearance.Aegis.Body">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Aegis.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Aegis.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_disabled</item>
    </style>

    <style name="TextAppearance.Aegis.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ══════════ CARDS ══════════ -->
    <!-- Flat premium surface + hairline stroke (no heavy elevation). -->
    <style name="AegisDrive.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="strokeColor">@color/border_subtle</item>
    </style>

    <style name="Aegis.Card" parent="AegisDrive.CardView" />

    <style name="Aegis.Card.Interactive" parent="AegisDrive.CardView">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="rippleColor">@color/accent_soft</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- ══════════ BUTTONS ══════════ -->
    <style name="Aegis.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/aegis_blue</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.Aegis.Button</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="elevation">@dimen/elevation_none</item>
    </style>

    <style name="Aegis.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/border_visible</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Aegis.Button</item>
        <item name="rippleColor">@color/accent_soft</item>
    </style>

    <style name="Aegis.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/aegis_blue</item>
        <item name="android:textAppearance">@style/TextAppearance.Aegis.Button</item>
        <item name="rippleColor">@color/accent_soft</item>
    </style>

    <!-- ══════════ CHIP ══════════ -->
    <style name="Aegis.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/colorSurface</item>
        <item name="chipStrokeColor">@color/border_subtle</item>
        <item name="chipStrokeWidth">@dimen/stroke_hairline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
    </style>

    <!-- ══════════ TEXT INPUT ══════════ -->
    <style name="AegisDrive.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/aegis_blue</item>
        <item name="boxStrokeWidth">@dimen/stroke_hairline</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="hintTextColor">@color/aegis_blue</item>
        <item name="android:textColorHint">@color/text_disabled</item>
    </style>

    <!-- ══════════ MOTION: GLOBAL ACTIVITY TRANSITIONS ══════════ -->
    <style name="Animation.Aegis.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- ══════════ BOTTOM NAV ACTIVE INDICATOR ══════════ -->
    <style name="Aegis.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_soft</item>
    </style>

    <!-- ══════════ DIVIDER ══════════ -->
    <style name="Aegis.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/stroke_hairline</item>
        <item name="android:background">@color/border_subtle</item>
    </style>
</resources>
